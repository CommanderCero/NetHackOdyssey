{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Current File",
            "type": "debugpy",
            "python": "/usr/bin/python",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "console": "integratedTerminal",
            "justMyCode": false,
        },
        {
            "name": "Train CPC",
            "type": "debugpy",
            "python": "/usr/bin/python",
            "request": "launch",
            "program": "train_cpc.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "experiment=04_50m_16bit_only",
                "paths=default",
                "logger.offline=True",
                "data.num_workers=0"
            ]
        }
    ]
}
