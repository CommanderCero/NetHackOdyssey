{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Current File",
            "type": "debugpy",
            "python": "/usr/bin/python",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "experiment=02b_increase_sample_difficulty",
                "paths=default",
                "logger.offline=True"
            ]
        }
    ]
}
